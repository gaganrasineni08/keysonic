{
  "name": "keysonic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "daemon:build": "clang -O2 -framework Cocoa -framework ApplicationServices -framework AudioToolbox -o daemon/keysonic-daemon daemon/keysonic-daemon.m",
    "daemon:start": "./daemon/keysonic-daemon",
    "daemon:stop": "pkill -f keysonic-daemon"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.460.0",
    "canvas-confetti": "^1.9.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
